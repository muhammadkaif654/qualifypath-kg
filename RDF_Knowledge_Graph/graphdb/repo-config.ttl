# GraphDB repository configuration for QualifyPath-KG (IPL 2026).
# Ruleset OWL2-RL (optimized): supports subPropertyOf, domain/range, inverseOf,
# propertyChainAxiom and the consistency checks used by the ontology.
# Create it in Workbench: Setup -> Repositories -> Create new repository -> Import repository config file.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep:     <http://www.openrdf.org/config/repository#> .
@prefix sr:      <http://www.openrdf.org/config/repository/sail#> .
@prefix sail:    <http://www.openrdf.org/config/sail#> .
@prefix graphdb: <http://www.ontotext.com/config/graphdb#> .

[] a rep:Repository ;
    rep:repositoryID "qualifypath-ipl2026" ;
    rdfs:label "QualifyPath-KG - IPL 2026 (snapshot after match 39)" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "graphdb:Sail" ;
            graphdb:ruleset "owl2-rl-optimized" ;
            graphdb:disable-sameAs "true" ;
            graphdb:check-for-inconsistencies "true" ;
            graphdb:base-URL "http://example.org/qualifypath/resource/" ;
            graphdb:enable-context-index "false" ;
            graphdb:enablePredicateList "true" ;
            graphdb:enable-literal-index "true" ;
            graphdb:in-memory-literal-properties "true" ;
            graphdb:query-timeout "0" ;
            graphdb:query-limit-results "0" ;
            graphdb:throw-QueryEvaluationException-on-timeout "false" ;
            graphdb:read-only "false"
        ]
    ] .
